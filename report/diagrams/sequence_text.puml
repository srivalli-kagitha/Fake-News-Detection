@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam roundcorner 6
skinparam componentStyle rectangle
skinparam rectangleBorderColor #333333
skinparam rectangleBackgroundColor #F7F8FA
skinparam packageBorderColor #555555
skinparam actorBorderColor #333333
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #F7F8FA
skinparam classBorderColor #333333
skinparam classBackgroundColor #F7F8FA
skinparam activityBorderColor #333333
skinparam activityBackgroundColor #F7F8FA
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #F7F8FA
skinparam databaseBackgroundColor #F7F8FA
skinparam noteBackgroundColor #FFFBE6
actor User
participant "React UI" as UI
participant "FastAPI\n/text/analyze" as API
participant "TextClassifier" as C
participant "ClaimVerifier" as V
participant "Live search" as R
participant "LLM (Groq)" as N
database SQLite as DB
User -> UI : paste article, click Check
UI -> API : POST {text, language, verify_claims}
API -> API : resolve_language()
API -> C : predict(text)
C --> API : label, p_fake
API -> V : verify_text(text, lang)
V -> V : extract_claims()
V -> N : plan queries(claim)
N --> V : up to 3 search queries
V -> R : Wikipedia, web, News, fact-checks (20 s limit)
R --> V : passages
V -> V : E5 selection (top 10, sim >= 0.80)
V -> N : verdict(claim, date, passages)
N --> V : label, reason, cited passages
V --> API : claims + summary
API -> API : combine() -> fake risk
API -> DB : save_check()
API --> UI : verdict, claims, evidence
UI --> User : report (verdict first)
note right of UI : steps and elapsed time\nshown while waiting
UI -> API : POST /text/explain
API -> C : occlusion, one run per content word
API --> UI : word weights
API -> DB : add highlights to saved report
UI --> User : highlighted article
@enduml
