@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam roundcorner 6
skinparam componentStyle rectangle
skinparam rectangleBorderColor #333333
skinparam rectangleBackgroundColor #F7F8FA
skinparam packageBorderColor #555555
skinparam actorBorderColor #333333
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #F7F8FA
skinparam classBorderColor #333333
skinparam classBackgroundColor #F7F8FA
skinparam activityBorderColor #333333
skinparam activityBackgroundColor #F7F8FA
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #F7F8FA
skinparam databaseBackgroundColor #F7F8FA
skinparam noteBackgroundColor #FFFBE6
actor User
package "Frontend (React + Vite, port 5173)" {
  rectangle "Start / Text / Image /\nClaims / Batch / History pages" as UI
}
package "Backend (FastAPI, port 8000)" {
  rectangle "REST routers\n/text /image /claims\n/batch /history /health" as API
  package "Text pipeline" {
    rectangle "Language detection" as LD
    rectangle "DeBERTa-v3-large (EN)\nIndicBERT v2 (TE)" as CLS
    rectangle "Occlusion explainer\n(LIME optional)" as LIME
  }
  package "Claim verification" {
    rectangle "Claim extractor\n(spaCy + scoring)" as CE
    rectangle "Live search\n(Wikipedia, web, News,\nFact Check API, corpus)" as RET
    rectangle "LLM verifier\n(gpt-oss-120b, E5 selection)" as LLMV
    rectangle "NLI verifier (fallback)\n(DeBERTa / mDeBERTa)" as NLI
    rectangle "Aggregation + fusion" as AGG
  }
  package "Image pipeline" {
    rectangle "CLIP ViT-L/14 head\n+ Swin-V2 detector (averaged)" as CLIP
    rectangle "Grad-CAM" as CAM
  }
  database "SQLite\n(history + full reports)" as DB
  rectangle "Background\nmodel warm-up" as WU
  database "Evidence corpus\n(JSONL + FAISS index)" as EV
}
User --> UI
UI --> API : JSON / multipart
API --> LD
LD --> CLS
CLS --> LIME
LD --> CE
CE --> RET
RET --> EV
RET --> LLMV
RET ..> NLI : if no LLM
LLMV --> AGG
NLI --> AGG
API --> CLIP
CLIP --> CAM
API --> DB
WU ..> CLS
WU ..> CLIP
cloud "Groq API\n(or local Ollama)" as GROQ
cloud "Search engines,\nWikipedia, Google News" as WEB
LLMV --> GROQ
RET --> WEB
@enduml
