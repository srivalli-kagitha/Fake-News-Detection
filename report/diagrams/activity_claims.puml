@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam roundcorner 6
skinparam componentStyle rectangle
skinparam rectangleBorderColor #333333
skinparam rectangleBackgroundColor #F7F8FA
skinparam packageBorderColor #555555
skinparam actorBorderColor #333333
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #F7F8FA
skinparam classBorderColor #333333
skinparam classBackgroundColor #F7F8FA
skinparam activityBorderColor #333333
skinparam activityBackgroundColor #F7F8FA
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #F7F8FA
skinparam databaseBackgroundColor #F7F8FA
skinparam noteBackgroundColor #FFFBE6
start
:Receive article text and language;
:Split into sentences (spaCy / punctuation);
:Score each sentence for check-worthiness\n(entities, numbers, factual verbs);
:Keep top 8 claims in article order;
repeat
  :Retrieve top-3 passages (BGE-M3 + FAISS);
  :Drop passages with similarity < 0.45;
  if (Fact Check API key set?) then (yes)
    :Add fact-check results;
  else (no)
  endif
  if (Any evidence?) then (yes)
    :Run NLI on (evidence, claim) pairs;
    if (max contradiction >= 0.5\nand >= max entailment?) then (yes)
      :Label = Contradiction;
    elseif (max entailment >= 0.5?) then (yes)
      :Label = Support;
    else
      :Label = Unknown;
    endif
  else (no)
    :Label = Unknown;
  endif
repeat while (more claims?)
:Compute score S and credibility C = (S+1)/2;
:Overall verdict: Credible / Misleading /\nMixed / Unverified;
stop
@enduml
