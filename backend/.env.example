# TruthLens AI backend settings.
# start.py copies this file to .env on first run. Edit .env, not this file.

# ---------- Fine-tuned models (produced by the scripts in /training) ----------
# Paths are relative to the backend folder. A HuggingFace model id also works.
TEXT_EN_MODEL=models/text_en
TEXT_TE_MODEL=models/text_te
IMAGE_MODEL=models/image_detector
# Second image detector trained on modern AI images (SDXL, Midjourney...). Its score is averaged
# with ours. Leave empty to use only our CLIP model.
MODERN_IMAGE_MODEL=haywoodsloan/ai-image-detector-deploy

# ---------- Pre-trained models (downloaded automatically on first use) ----------
NLI_EN_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
NLI_MULTI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
EMBED_MODEL=BAAI/bge-m3
# Which model decides that evidence SUPPORTS an English claim: minicheck (reads all evidence
# together) or nli. Contradictions and Telugu always use the NLI models.
SUPPORT_VERIFIER=nli
MINICHECK_MODEL=lytang/MiniCheck-DeBERTa-v3-Large

# ---------- LLM fact checker (recommended) ----------
# groq: free key from https://console.groq.com (API Keys > Create API Key). Fast.
# ollama: a local model, free and offline but slow on a CPU (install Ollama, then: ollama pull qwen3:4b)
# none: no LLM, use the NLI pipeline below. If the LLM fails, the NLI pipeline is used automatically.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ---------- Evidence ----------
EVIDENCE_DIR=data/evidence
# Search Wikipedia and Google News live for every claim (needs internet, no key).
# Set to false for offline use; the local corpus is always searched.
LIVE_SEARCH=true
LIVE_TOP_K=2
# Also search the whole web with DuckDuckGo (no key). Part of live search.
WEB_SEARCH=false
# Optional free key for published fact-checks: https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=

# ---------- Tuning ----------
MAX_TEXT_LENGTH=256
LIME_NUM_SAMPLES=200
MAX_CLAIMS=8
EVIDENCE_TOP_K=3
EVIDENCE_MIN_SIMILARITY=0.45
# Weight of the claim evidence in the overall verdict (the text model gets the rest).
EVIDENCE_WEIGHT=0.7
MAX_BATCH_ROWS=500

# auto | cpu | cuda
DEVICE=auto
